# Reusable Python lab image. Build from repo root:
#   docker build -f docker/Dockerfile.python --build-arg LAB=langgraph-python .
FROM node:20-bookworm-slim AS ui

WORKDIR /ui
COPY shared/feature-delivery-ui/package.json shared/feature-delivery-ui/package-lock.json ./
RUN npm ci
COPY shared/feature-delivery-ui/ ./
RUN npm run build

FROM python:3.12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*

ARG LAB=langgraph-python
ENV LAB=${LAB} \
  HOST=0.0.0.0 \
  PORT=8000 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY shared/ /workspace/shared/
COPY --from=ui /ui/dist /workspace/shared/feature-delivery-ui/dist
COPY ${LAB}/ /workspace/${LAB}/

WORKDIR /workspace/${LAB}

RUN pip install --no-cache-dir -U pip setuptools wheel \
  && pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["python", "-m", "app.api"]
