LLM_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# MODEL=gpt-4.1-mini
# MODEL=deepseek-chat
# MODEL=google/gemini-2.0-flash-001
# illustrator (generate_image) requires OPENAI_API_KEY even when LLM uses DeepSeek or OpenRouter

# Langflow server (UI-first mode)
LANGFLOW_URL=http://localhost:7860
LANGFLOW_SUPERUSER=langflow
LANGFLOW_SUPERUSER_PASSWORD=changeme-dev
LANGFLOW_AUTO_LOGIN=true
# API key is validated from env (no UI Settings → API Keys step).
# ./run.sh setup|server auto-fills empty LANGFLOW_API_KEY / LANGFLOW_SECRET_KEY.
# SECRET_KEY must be Fernet (32 url-safe base64 bytes); setup regenerates invalid hex.
LANGFLOW_API_KEY_SOURCE=env
LANGFLOW_API_KEY=
LANGFLOW_SECRET_KEY=

# Sandbox paths inside Docker (defaults match docker-compose mounts)
SANDBOX_OUTPUT_ROOT=/app/output
SANDBOX_KNOWLEDGE_DIR=/app/knowledge
